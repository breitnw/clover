cabal-version:      3.0
name:               clover
version:            0.1.0.0
synopsis:           Design your own awesome graphical MPD client
description:        Design your own awesome graphical MPD client
                    .
                    <https://github.com/breitnw/clover#readme>
license:            GPL-3.0-only
license-file:       LICENSE
author:             Nick Breitling
maintainer:         Nick Breitling <breitling.nw@gmail.com>
copyright:          (c) 2026 Nick Breitling
category:           Graphics, Sound
build-type:         Simple

extra-doc-files:    CHANGELOG.md

homepage:           https://github.com/breitnw/clover#readme
bug-reports:        https://github.com/breitnw/clover/issues

source-repository head
  type:     git
  location: https://github.com/breitnw/libmpd-effectful

common warnings
    ghc-options: -Wall

common language
    default-language: Haskell2010
    default-extensions:
        ImportQualifiedPost
        FlexibleContexts
        TypeApplications
        GADTs
        LambdaCase
        TypeFamilies
        TypeOperators
        DataKinds
        ConstraintKinds
        ScopedTypeVariables

flag examples
  description: Build example executables
  default: False
  manual: True

-- flag pkgconfig
--   description: Use pkgconfig to sort out sdl3 dependency
--   default: True
--   manual: True

-- extra-source-files:
--     SDL3/include/SDL3/SDL.h

-- library ---------------------------------------------------------------------

-- The clover library mostly contains effects and their implementations.
-- It is housed in the lib/ directory.

library
    import:           warnings, language
    exposed:          True
    default-language: Haskell2010
    hs-source-dirs:   lib

    extra-libraries: SDL3
    pkgconfig-depends:
      sdl3 >=3.3.0

    build-depends: 
      base              >=4.16 && <5,
      filepath          >=1    && <2,
      text             ^>=2.1.4,
      bytestring       ^>=0.12.2,
      containers       ^>=0.8,
      -- sdl3             ^>=0.1,
      bitmap           ^>=0.0.2,
      stb-image        ^>=0.2.1,
      effectful        ^>=2.6.1,
      effectful-th     ^>=1.0.0.4,
      libmpd-effectful ^>=0.1

    exposed-modules: 
      -- Utils
      Util,

      -- Effects
      Effectful.MusicPlayer,
      Effectful.MusicPlayer.Handler.MPD,

      Effectful.ImageLoader,

      Effectful.Logger,
      Effectful.Logger.Handler.SDL,

      Effectful.Renderer,
      Effectful.Renderer.Handler.SDL,

    other-modules:    
      -- Effects
      Effectful.MusicPlayer.Effect,
      Effectful.MusicPlayer.Types,

      Effectful.ImageLoader.Effect,
      Effectful.ImageLoader.Types,

      Effectful.Logger.Effect,

      Effectful.Renderer.Effect,
      Effectful.Renderer.Types,
      Effectful.Renderer.Managed,

      -- FFIs (should only be exposed through effects)
      Foreign.SDL,

-- main executable -------------------------------------------------------------

-- Source files for the main clover executable are housed in the src/ directory.

executable clover
    import:           warnings, language
    default-language: Haskell2010
    main-is:          Main.hs
    hs-source-dirs:   src

    build-depends:
      base >=4.16 && <5,
      clover

    other-modules:
      Clover.App,
      Clover.Config,
      -- TODO rename vv
      Clover.Shared,

      Clover.Graphics.Theme,
      Clover.Graphics.Thread,
      Clover.Graphics.Types,

      Clover.Music.Thread,

-- examples --------------------------------------------------------------------

-- Examples are housed in the examples/ directory. They can be built with the
-- examples flag: 'cabal build --flag examples'

-- One example is (ideally) provided for each effect in lib/ to demonstrate its
-- behavior and usage. 

common example-exe
    import:           warnings, language
    default-language: Haskell2010
    hs-source-dirs:   examples

    -- if flag(examples)
    --   buildable: True
    -- else
    --   buildable: False

    build-depends:
      base >=4.16 && <5,
      effectful ^>=2.6.1,
      clover

executable logger
    import:  example-exe
    main-is: Logger.hs

executable fail
    import:  example-exe
    main-is: Fail.hs

executable renderer
    import:  example-exe
    main-is: Renderer.hs

executable sdl
    import:  example-exe
    main-is: SDL.hs
